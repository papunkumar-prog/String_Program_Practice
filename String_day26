# ==========================================
# NUMBER GUESSING GAME
# ==========================================

import random


# Execution flow:
# 1. Generate a random number.
# 2. Give the player 7 attempts.
# 3. Check each guess and display a hint.
# 4. Display the result when the game ends.

def play_game():

    secret_number = random.randint(1, 100)
    max_attempts = 7
    attempts_left = max_attempts

    print("\nI have selected a number between 1 and 100.")
    print("You have 7 attempts to guess it!")

    while attempts_left > 0:

        guess = input("\nEnter your guess: ").strip()

        # Validate the user's input
        if not guess.isdigit():
            print("Please enter a valid number.")
            continue

        guess = int(guess)

        if guess < 1 or guess > 100:
            print("Enter a number between 1 and 100.")
            continue

        attempts_left -= 1

        if guess == secret_number:
            attempts_used = max_attempts - attempts_left

            print("\nCongratulations! You guessed correctly.")
            print("Secret number:", secret_number)
            print("Attempts used:", attempts_used)
            return

        elif guess < secret_number:
            print("Too low! Try a higher number.")

        else:
            print("Too high! Try a lower number.")

        print("Attempts remaining:", attempts_left)

    print("\nGame over!")
    print("The correct number was:", secret_number)


# Execution flow:
# 1. Start the game.
# 2. Ask whether the player wants another round.
# 3. Repeat until the player chooses to exit.

def main():

    while True:

        print("\n========== NUMBER GUESSING GAME ==========")
        print("1. Start Game")
        print("2. Exit")
        print("==========================================")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            play_game()

        elif choice == "2":
            print("Thanks for playing!")
            break

        else:
            print("Invalid choice. Enter 1 or 2.")


# Start program execution
main()
