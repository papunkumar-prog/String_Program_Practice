import sqlite3
from contextlib import closing

DB_NAME = "assets.db"


# Execution flow:
# 1. Connect to the SQLite database.
# 2. Create the assets table if it does not exist.
# 3. Keep existing records unchanged.
def setup_database():

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS assets (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    asset_tag TEXT NOT NULL UNIQUE,
                    device_type TEXT NOT NULL,
                    assigned_to TEXT NOT NULL,
                    serial_number TEXT,
                    status TEXT NOT NULL
                )
            """)

            connection.commit()

    except sqlite3.Error as error:
        print("Database setup error:", error)


# Execution flow:
# 1. Accept asset details.
# 2. Validate the information.
# 3. Insert the asset into the database.
# 4. Display the generated asset ID.
def add_asset():

    asset_tag = input("Enter asset tag: ").strip().upper()
    device_type = input("Enter device type: ").strip().title()
    assigned_to = input("Enter employee name: ").strip().title()
    serial_number = input("Enter serial number: ").strip()

    if asset_tag == "" or device_type == "":
        print("Asset tag and device type are required.")
        return

    if assigned_to == "":
        assigned_to = "Unassigned"

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                INSERT INTO assets
                (asset_tag, device_type, assigned_to,
                 serial_number, status)
                VALUES (?, ?, ?, ?, ?)
            """, (
                asset_tag,
                device_type,
                assigned_to,
                serial_number,
                "Available"
            ))

            asset_id = cursor.lastrowid

            connection.commit()

            print("\nAsset added successfully!")
            print("Asset ID:", asset_id)
            print("Asset Tag:", asset_tag)

    except sqlite3.IntegrityError:
        print("This asset tag already exists.")

    except sqlite3.Error as error:
        print("Database error:", error)


# Execution flow:
# 1. Read all asset records.
# 2. Check whether assets are available.
# 3. Display all asset information.
def view_assets():

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                SELECT * FROM assets ORDER BY id
            """)

            assets = cursor.fetchall()

            if not assets:
                print("No assets available.")
                return

            print("\n========== ALL IT ASSETS ==========")

            for asset in assets:

                print("\nAsset ID:", asset[0])
                print("Asset Tag:", asset[1])
                print("Device Type:", asset[2])
                print("Assigned To:", asset[3])
                print("Serial Number:", asset[4])
                print("Status:", asset[5])
                print("----------------------------------")

    except sqlite3.Error as error:
        print("Database error:", error)


# Execution flow:
# 1. Ask for an asset tag.
# 2. Search the database.
# 3. Display the matching asset details.
def search_asset():

    asset_tag = input("Enter asset tag: ").strip().upper()

    if asset_tag == "":
        print("Asset tag cannot be empty.")
        return

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                SELECT * FROM assets
                WHERE asset_tag = ?
            """, (asset_tag,))

            asset = cursor.fetchone()

            if asset is None:
                print("Asset not found.")
                return

            print("\n========== ASSET DETAILS ==========")
            print("Asset ID:", asset[0])
            print("Asset Tag:", asset[1])
            print("Device Type:", asset[2])
            print("Assigned To:", asset[3])
            print("Serial Number:", asset[4])
            print("Status:", asset[5])

    except sqlite3.Error as error:
        print("Database error:", error)


# Execution flow:
# 1. Ask for the asset tag.
# 2. Display available statuses.
# 3. Validate the selected status.
# 4. Update the database record.
def update_asset_status():

    asset_tag = input("Enter asset tag: ").strip().upper()

    if asset_tag == "":
        print("Asset tag cannot be empty.")
        return

    print("\nSelect new status:")
    print("1. Available")
    print("2. Assigned")
    print("3. Under Repair")
    print("4. Retired")

    choice = input("Enter your choice: ").strip()

    statuses = {
        "1": "Available",
        "2": "Assigned",
        "3": "Under Repair",
        "4": "Retired"
    }

    if choice not in statuses:
        print("Invalid status choice.")
        return

    new_status = statuses[choice]

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                UPDATE assets
                SET status = ?
                WHERE asset_tag = ?
            """, (new_status, asset_tag))

            connection.commit()

            if cursor.rowcount > 0:
                print("Asset status updated successfully!")
            else:
                print("Asset not found.")

    except sqlite3.Error as error:
        print("Database error:", error)


# Execution flow:
# 1. Ask for the asset tag.
# 2. Find the matching asset.
# 3. Ask for deletion confirmation.
# 4. Delete the selected database record.
def delete_asset():

    asset_tag = input("Enter asset tag to delete: ").strip().upper()

    if asset_tag == "":
        print("Asset tag cannot be empty.")
        return

    confirm = input(
        "Are you sure you want to delete this asset? (yes/no): "
    ).strip().lower()

    if confirm != "yes":
        print("Deletion cancelled.")
        return

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                DELETE FROM assets
                WHERE asset_tag = ?
            """, (asset_tag,))

            connection.commit()

            if cursor.rowcount > 0:
                print("Asset deleted successfully!")
            else:
                print("Asset not found.")

    except sqlite3.Error as error:
        print("Database error:", error)


# Execution flow:
# 1. Count all assets.
# 2. Group assets by status.
# 3. Display the total and status-wise summary.
def asset_summary():

    try:
        with closing(sqlite3.connect(DB_NAME)) as connection:

            cursor = connection.cursor()

            cursor.execute("""
                SELECT COUNT(*) FROM assets
            """)

            total = cursor.fetchone()[0]

            cursor.execute("""
                SELECT status, COUNT(*)
                FROM assets
                GROUP BY status
            """)

            summary = cursor.fetchall()

            print("\n========== ASSET SUMMARY ==========")
            print("Total assets:", total)

            for status, count in summary:
                print(status + ":", count)

    except sqlite3.Error as error:
        print("Database error:", error)


# ==========================================
# MAIN PROGRAM
# ==========================================

def main():

    setup_database()

    while True:

        print("\n========== IT ASSET MANAGEMENT ==========")
        print("1. Add Asset")
        print("2. View All Assets")
        print("3. Search Asset")
        print("4. Update Asset Status")
        print("5. Delete Asset")
        print("6. Asset Summary")
        print("7. Exit")
        print("=========================================")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            add_asset()

        elif choice == "2":
            view_assets()

        elif choice == "3":
            search_asset()

        elif choice == "4":
            update_asset_status()

        elif choice == "5":
            delete_asset()

        elif choice == "6":
            asset_summary()

        elif choice == "7":
            print("Thank you for using IT Asset Management!")
            break

        else:
            print("Invalid choice. Please select 1 to 7.")


# Start program execution
main()
