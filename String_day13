#--------------------------------------------------------------------------
# Check Whether the String Starts and Ends With the Same Character
#--------------------------------------------------------------------------

text = input("Enter a string: ")

if len(text) > 0:
    if text[0].lower() == text[-1].lower():
        print("First and last characters are the same")
    else:
        print("First and last characters are different")
else:
    print("String is empty")

#--------------------------------------------------------------------------
# Remove All Vowels From a String
#--------------------------------------------------------------------------

text = input("Enter a string: ")

result = ""

for char in text:
    if char.lower() not in "aeiou":
        result += char

print("Original:", text)
print("Without vowels:", result)

#--------------------------------------------------------------------------
# Print the ASCII Value of Each Character
#--------------------------------------------------------------------------

text = input("Enter a string: ")

for char in text:
    print(char, "=", ord(char))

#--------------------------------------------------------------------------
# Swap the First and Last Character
#--------------------------------------------------------------------------

text = input("Enter a string: ")

if len(text) > 1:
    result = text[-1] + text[1:-1] + text[0]
    print("Original:", text)
    print("After swapping:", result)
else:
    print("Enter at least 2 characters")

#--------------------------------------------------------------------------
# Find the Word With the Most Characters
#--------------------------------------------------------------------------

sentence = input("Enter a sentence: ")

words = sentence.split()

longest = ""

for word in words:
    if len(word) > len(longest):
        longest = word

print("Longest word:", longest)
print("Number of characters:", len(longest))
