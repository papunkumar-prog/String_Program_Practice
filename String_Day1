"""Check whether a string contains both letters and numbers."""
str = "papu34n"
has_Latter=False
has_number=False
for i in str:
    if i.isdigit():
        has_number=True
    if i.isalpha():
        has_Latter=True
if has_Latter and has_number:
    print(f"The string {str} contains number along with letters")
else:
    print(f"The string {str} contains only letters")
