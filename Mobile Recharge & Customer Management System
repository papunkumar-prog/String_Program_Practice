# ============================================================

# PLAN SUMMARY

# ============================================================

def plan_summary():

```
print("\n----------- PLAN SUMMARY -----------")

summary = {}

# Start each plan with zero customers
for plan in plans:

    summary[plan] = 0

# Count customers
for customer in customers:

    plan = customer["plan"]

    summary[plan] = (
        summary[plan] + 1
    )

for plan, count in summary.items():

    print(plan, ":", count)
```

# ============================================================

# DELETE CUSTOMER

# ============================================================

def delete_customer():

```
print("\n----------- DELETE CUSTOMER -----------")

try:

    customer_id = int(
        input("Enter customer ID: ")
    )

    customer = find_customer(customer_id)

    if customer is None:

        print("Customer not found.")
        return

    print("Customer:", customer["name"])
    print("Phone   :", customer["phone"])

    confirm = input(
        "Delete this customer? (y/n): "
    ).strip().lower()

    if confirm == "y":

        customers.remove(customer)

        print("Customer deleted.")

    else:

        print("Delete cancelled.")


except ValueError:

    print("Enter a valid customer ID.")
```

