# ============================================================

# AVERAGE RECHARGE

# ============================================================

def average_recharge():

```
print("\n----------- AVERAGE RECHARGE -----------")

if len(customers) == 0:

    print("No customers found.")
    return

amounts = []

for customer in customers:

    amount = plan_price[
        customer["plan"]
    ]

    amounts.append(amount)

amount_array = np.array(amounts)

average = np.mean(amount_array)

print(
    "Average recharge amount: ₹",
    round(average, 2)
)
```

