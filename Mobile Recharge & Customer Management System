# ============================================================

# MOBILE RECHARGE & CUSTOMER MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Available mobile plans

plans = (
"Basic",
"Standard",
"Premium",
"Unlimited"
)

# Plan prices

plan_price = {
"Basic": 199,
"Standard": 299,
"Premium": 499,
"Unlimited": 799
}

# Customer details

customers = [
{
"id": 101,
"name": "Papun",
"phone": "9876543210",
"plan": "Standard",
"validity": 28
},
{
"id": 102,
"name": "Amit",
"phone": "9123456780",
"plan": "Premium",
"validity": 56
},
{
"id": 103,
"name": "Rahul",
"phone": "9988776655",
"plan": "Basic",
"validity": 28
}
]

# ============================================================

# FIND CUSTOMER

# ============================================================

def find_customer(customer_id):

```
for customer in customers:

    if customer["id"] == customer_id:
        return customer

return None
```

# ============================================================

# SHOW PLANS

# ============================================================

def show_plans():

```
print("\n----------- RECHARGE PLANS -----------")

for plan in plans:

    print(
        plan,
        "- ₹",
        plan_price[plan]
    )
```

# ============================================================

# ADD CUSTOMER

# ============================================================

def add_customer():

```
print("\n----------- ADD CUSTOMER -----------")

try:

    customer_id = int(
        input("Enter customer ID: ")
    )

    for customer in customers:

        if customer["id"] == customer_id:

            print("Customer ID already exists.")
            return

    name = input(
        "Enter customer name: "
    ).strip().title()

    if name == "":

        print("Name is required.")
        return

    phone = input(
        "Enter mobile number: "
    ).strip()

    if len(phone) != 10 or not phone.isdigit():

        print("Enter a valid 10-digit mobile number.")
        return

    show_plans()

    plan = input(
        "Enter plan name: "
    ).strip().title()

    if plan not in plans:

        print("Invalid plan.")
        return

    validity = int(
        input("Enter plan validity in days: ")
    )

    if validity <= 0:

        print("Validity must be greater than zero.")
        return

    customer = {
        "id": customer_id,
        "name": name,
        "phone": phone,
        "plan": plan,
        "validity": validity
    }

    customers.append(customer)

    print("Customer added successfully.")


except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL CUSTOMERS

# ============================================================

def show_customers():

```
print("\n----------- ALL CUSTOMERS -----------")

if len(customers) == 0:

    print("No customers found.")
    return

for customer in customers:

    amount = plan_price[customer["plan"]]

    print("-------------------------------------")
    print("ID       :", customer["id"])
    print("Name     :", customer["name"])
    print("Phone    :", customer["phone"])
    print("Plan     :", customer["plan"])
    print("Validity :", customer["validity"], "days")
    print("Recharge : ₹", amount)
```

# ============================================================

# SEARCH CUSTOMER

# ============================================================

def search_customer():

```
print("\n----------- SEARCH CUSTOMER -----------")

phone = input(
    "Enter mobile number: "
).strip()

for customer in customers:

    if customer["phone"] == phone:

        amount = plan_price[
            customer["plan"]
        ]

        print("\nCustomer found")
        print("ID       :", customer["id"])
        print("Name     :", customer["name"])
        print("Phone    :", customer["phone"])
        print("Plan     :", customer["plan"])
        print("Validity :", customer["validity"], "days")
        print("Recharge : ₹", amount)

        return

print("Customer not found.")
```

# ============================================================

# RECHARGE CUSTOMER

# ============================================================

def recharge_customer():

```
print("\n----------- RECHARGE CUSTOMER -----------")

try:

    customer_id = int(
        input("Enter customer ID: ")
    )

    customer = find_customer(customer_id)

    if customer is None:

        print("Customer not found.")
        return

    print("Customer:", customer["name"])
    print("Current plan:", customer["plan"])

    show_plans()

    new_plan = input(
        "Enter new plan: "
    ).strip().title()

    if new_plan not in plans:

        print("Invalid plan.")
        return

    customer["plan"] = new_plan

    print("Recharge successful.")
    print("New plan:", new_plan)
    print(
        "Amount: ₹",
        plan_price[new_plan]
    )


except ValueError:

    print("Enter a valid customer ID.")
```

# ============================================================

# UPDATE VALIDITY

# ============================================================

def update_validity():

```
print("\n----------- UPDATE VALIDITY -----------")

try:

    customer_id = int(
        input("Enter customer ID: ")
    )

    customer = find_customer(customer_id)

    if customer is None:

        print("Customer not found.")
        return

    print(
        "Current validity:",
        customer["validity"],
        "days"
    )

    days = int(
        input("Enter new validity: ")
    )

    if days <= 0:

        print("Validity must be greater than zero.")
        return

    customer["validity"] = days

    print("Validity updated successfully.")


except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# CHECK VALIDITY

# ============================================================

def validity_status(days):

```
if days <= 5:

    return "Expiring Soon"

elif days <= 15:

    return "Active"

else:

    return "Long Validity"
```

# ============================================================

# VALIDITY REPORT

# ============================================================

def validity_report():

```
print("\n----------- VALIDITY REPORT -----------")

if len(customers) == 0:

    print("No customers found.")
    return

for customer in customers:

    status = validity_status(
        customer["validity"]
    )

    print("-------------------------------------")
    print("Name     :", customer["name"])
    print("Phone    :", customer["phone"])
    print("Validity :", customer["validity"], "days")
    print("Status   :", status)
```

# ============================================================

# HIGHEST RECHARGE PLAN

# ============================================================

def highest_recharge():

```
print("\n----------- HIGHEST RECHARGE -----------")

if len(customers) == 0:

    print("No customers found.")
    return

amounts = []

for customer in customers:

    amount = plan_price[
        customer["plan"]
    ]

    amounts.append(amount)

amount_array = np.array(amounts)

highest = np.max(amount_array)

for customer in customers:

    amount = plan_price[
        customer["plan"]
    ]

    if amount == highest:

        print("Customer :", customer["name"])
        print("Plan     :", customer["plan"])
        print("Amount   : ₹", highest)
```

