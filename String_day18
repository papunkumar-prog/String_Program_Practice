    print("7. Count a character")
    print("8. Exit")
    print("=====================================")

    choice = input("Enter your choice: ")

    if choice == "1":
        count_characters(text)

    elif choice == "2":
        count_words(text)

    elif choice == "3":
        count_vowels_consonants(text)

    elif choice == "4":
        find_longest_word(text)

    elif choice == "5":
        reverse_sentence(text)

    elif choice == "6":
        check_palindrome(text)

    elif choice == "7":
        count_character(text)

    elif choice == "8":
