text = input("Enter a sentence: ")

while True:

    print("\n========== STRING ANALYZER ==========")
    print("1. Count characters")
    print("2. Count words")
    print("3. Count vowels and consonants")
    print("4. Find longest word")
    print("5. Reverse sentence")
