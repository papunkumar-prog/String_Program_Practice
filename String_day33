# ==========================================
# RANDOM PASSWORD GENERATOR
# ==========================================

import secrets
import string


# Execution flow:
# 1. Ask the user for the password length.
# 2. Validate the entered length.
# 3. Select characters from different groups.
# 4. Shuffle the characters.
# 5. Display the generated password.

def generate_password():

    length = input("Enter password length (minimum 8): ").strip()

    if not length.isdigit():
        print("Please enter a valid number.")
        return

    length = int(length)

    if length < 8:
        print("Password length must be at least 8.")
        return

    # Select at least one character from each group
    password_chars = [
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.ascii_uppercase),
        secrets.choice(string.digits),
        secrets.choice(string.punctuation)
    ]

    # Combine all character groups
    all_characters = (
        string.ascii_letters
        + string.digits
        + string.punctuation
    )

    # Fill the remaining password length
    for _ in range(length - len(password_chars)):
        password_chars.append(secrets.choice(all_characters))

    # Shuffle the characters so the groups are not predictable
    secrets.SystemRandom().shuffle(password_chars)

    # Convert the character list into a string
    password = "".join(password_chars)

    print("\nGenerated password:", password)
    print("Password length:", len(password))


# Execution flow:
# 1. Display the menu.
# 2. Generate a password when option 1 is selected.
# 3. Exit when option 2 is selected.

def main():

    while True:

        print("\n========== PASSWORD GENERATOR ==========")
        print("1. Generate Password")
        print("2. Exit")
        print("========================================")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            generate_password()

        elif choice == "2":
            print("Thank you for using Password Generator!")
            break

        else:
            print("Invalid choice. Please select 1 or 2.")


# Start program execution
main()
