#---------------------------------------------------------------------------
# Count Vowels and Consonants Separately
#---------------------------------------------------------------------------

text = input("Enter a string: ")

vowels = 0
consonants = 0

for char in text:
    if char.isalpha():
        if char.lower() in "aeiou":
            vowels += 1
        else:
            consonants += 1

print("Vowels:", vowels)
print("Consonants:", consonants)

#---------------------------------------------------------------------------
# Find the Second Character That Appears More Than Once
#---------------------------------------------------------------------------

text = input("Enter a string: ")

found = []

for char in text:
    if char != " " and text.count(char) > 1:
        if char not in found:
            found.append(char)

if len(found) >= 2:
    print("Second repeated character:", found[1])
else:
    print("Second repeated character not found")

#---------------------------------------------------------------------------
# Reverse the Order of Words
#---------------------------------------------------------------------------

sentence = input("Enter a sentence: ")

words = sentence.split()

words.reverse()

result = " ".join(words)

print("Original:", sentence)
print("Reversed words:", result)

#---------------------------------------------------------------------------
# Find All Digits Present in a String
#---------------------------------------------------------------------------

text = input("Enter a string: ")

digits = ""

for char in text:
    if char.isdigit():
        digits += char

if digits:
    print("Digits found:", digits)
else:
    print("No digits found")

#---------------------------------------------------------------------------
# Check Whether a Sentence Is a Palindrome
#---------------------------------------------------------------------------

text = input("Enter a sentence: ")

text = text.replace(" ", "").lower()

if text == text[::-1]:
    print("The sentence is a palindrome")
else:
    print("The sentence is not a palindrome")
