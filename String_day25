# ==========================================
# LIBRARY BOOK MANAGEMENT SYSTEM
# ==========================================

books = []


# Execution flow:
# 1. Ask for the book title and author.
# 2. Validate the entered information.
# 3. Generate a book ID.
# 4. Store the book in the list.
def add_book():

    title = input("Enter book title: ").strip()
    author = input("Enter author name: ").strip()

    if title == "" or author == "":
        print("Book title and author cannot be empty.")
        return

    # Generate an ID that is not already in use
    book_id = 1

    for book in books:
        if book["id"] >= book_id:
            book_id = book["id"] + 1

    new_book = {
        "id": book_id,
        "title": title,
        "author": author,
        "issued": False
    }

    books.append(new_book)

    print("Book added successfully!")
    print("Book ID:", book_id)


# Execution flow:
# 1. Check whether books are available.
# 2. Display each book's details.
# 3. Show whether each book is available or issued.
def view_books():

    if len(books) == 0:
        print("No books available.")
        return

    print("\n========== LIBRARY BOOKS ==========")

    for book in books:

        if book["issued"]:
            status = "Issued"
        else:
            status = "Available"

        print("ID:", book["id"])
        print("Title:", book["title"])
        print("Author:", book["author"])
        print("Status:", status)
        print("-----------------------------------")


# Execution flow:
# 1. Ask for a title to search.
# 2. Compare it with each stored book title.
# 3. Display matching books.
def search_book():

    search = input("Enter book title to search: ").strip().lower()

    if search == "":
        print("Search text cannot be empty.")
        return

    found = False

    for book in books:

        if search in book["title"].lower():

            print("\nBook found!")
            print("ID:", book["id"])
            print("Title:", book["title"])
            print("Author:", book["author"])

            if book["issued"]:
                print("Status: Issued")
            else:
                print("Status: Available")

            found = True

    if not found:
        print("Book not found.")


# Execution flow:
# 1. Ask for a book ID.
# 2. Validate the ID.
# 3. Find the matching book.
# 4. Update its status to issued.
def issue_book():

    if len(books) == 0:
        print("There are no books to issue.")
        return

    book_id = input("Enter book ID to issue: ").strip()

    if not book_id.isdigit():
        print("Please enter a valid book ID.")
        return

    book_id = int(book_id)

    for book in books:

        if book["id"] == book_id:

            if book["issued"]:
                print("This book has already been issued.")
            else:
                book["issued"] = True
                print("Book issued successfully!")

            return

    print("Book ID not found.")


# Execution flow:
# 1. Ask for the book ID.
# 2. Find the matching book.
# 3. Check whether it was issued.
# 4. Mark it as available again.
def return_book():

    book_id = input("Enter book ID to return: ").strip()

    if not book_id.isdigit():
        print("Please enter a valid book ID.")
        return

    book_id = int(book_id)

    for book in books:

        if book["id"] == book_id:

            if book["issued"]:
                book["issued"] = False
                print("Book returned successfully!")
            else:
                print("This book has not been issued.")

            return

    print("Book ID not found.")


# ==========================================
# MAIN PROGRAM
# ==========================================

while True:

    print("\n========== LIBRARY SYSTEM ==========")
    print("1. Add Book")
    print("2. View All Books")
    print("3. Search Book")
    print("4. Issue Book")
    print("5. Return Book")
    print("6. Exit")
    print("====================================")

    choice = input("Enter your choice: ").strip()

    if choice == "1":
        add_book()

    elif choice == "2":
        view_books()

    elif choice == "3":
        search_book()

    elif choice == "4":
        issue_book()

    elif choice == "5":
        return_book()

    elif choice == "6":
        print("Thank you for using the Library System!")
        break

    else:
        print("Invalid choice. Please select 1 to 6.")
